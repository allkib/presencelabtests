# Copy to .env and adjust. All settings use the POSEDEMO_ prefix.
POSEDEMO_MODEL=yolo11n-pose.pt        # yolo11s-pose.pt / yolo11m-pose.pt for more accuracy
POSEDEMO_DEVICE=auto                  # auto | mps | cuda | cpu
POSEDEMO_ENABLE_SOURCE=true            # false = browser-camera only (hosted)
POSEDEMO_SOURCE=0                     # camera index, or a video/image path / RTSP URL
POSEDEMO_IMGSZ=640
POSEDEMO_CONF=0.5
POSEDEMO_KP_CONF=0.35
POSEDEMO_POSE_THRESHOLD=0.6
POSEDEMO_SMOOTHING_WINDOW=7
POSEDEMO_MIRROR=true
POSEDEMO_HOST=127.0.0.1
POSEDEMO_PORT=8000
POSEDEMO_FORWARDED_ALLOW_IPS=127.0.0.1 # "*" behind a reverse proxy
POSEDEMO_MAX_BROWSER_SESSIONS=8
